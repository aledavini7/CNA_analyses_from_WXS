nextflow.enable.dsl=2

params {
    bam_dir    = null
    bam_pattern = '**/*.bam'
    fasta      = null
    fasta_fai  = null
    fasta_dict = null
    outdir     = 'results'
}

manifest {
    name            = 'cna-analyses-from-wxs'
    description     = 'CNA-focused analysis of WXS BAM files with optional variant calling'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
}

profiles {
    standard {
        process.executor = 'local'
    }
}
