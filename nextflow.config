nextflow.enable.dsl=2

// HPC container configuration, matching the working CLAM pipeline.
singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = '--bind /hpcnfs/ --bind /hpcscratch/ --bind /beegfs/'

params {
    bam_dir            = null
    outdir             = 'results'
    samtools_container = 'docker://quay.io/biocontainers/samtools:1.20--h50ea8bc_1'
}

manifest {
    name            = 'cna-analyses-from-wxs'
    description     = 'CNA-focused analysis of WXS BAM files with optional variant calling'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
}

profiles {
    standard {
        process.executor = 'local'
    }
}
