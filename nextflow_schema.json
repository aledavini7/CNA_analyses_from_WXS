{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/aledavini7/CNA_analyses_from_WXS/main/nextflow_schema.json",
  "title": "CNA analyses from WXS parameters",
  "description": "Schema for launching the WXS CNA analysis pipeline from Seqera.",
  "type": "object",
  "properties": {
    "samplesheet": {
      "type": "string",
      "format": "file-path",
      "x-label": "Samplesheet",
      "description": "Tab-separated manifest with sample_id, tumor_bam, normal_bam, and pairing_status.",
      "fa_icon": "fas fa-file-import"
    },
    "fasta": {"type":"string","format":"file-path","description":"b37 reference FASTA."},
    "targets_bed": {"type":"string","format":"file-path","description":"SureSelect v2 b37 target BED."},
    "cnvkit_container": {"type":"string","default":"docker://etal/cnvkit:0.9.11","hidden":true
    },
    "outdir": {
      "type": "string",
      "default": "results",
      "description": "Output directory."
    },
    "samtools_container": {
      "type": "string",
      "default": "docker://quay.io/biocontainers/samtools:1.20--h50ea8bc_1",
      "description": "Container image used for BAM indexing.",
      "hidden": true
    }
  },
  "required": ["samplesheet", "fasta", "targets_bed"]
}
