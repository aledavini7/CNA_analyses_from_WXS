{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CNA analyses from WXS parameters",
  "type": "object",
  "definitions": {
    "file_path": {
      "type": "string",
      "format": "file-path"
    }
  },
  "properties": {
    "bam_dir": {
      "type": "string",
      "format": "directory-path",
      "description": "Directory containing sample folders with BAM files. All BAMs are discovered recursively.",
      "help_text": "Example: /beegfs/scratch/ieo5898/phs000450_chapuy/bams"
    },
    "outdir": {
      "type": "string",
      "default": "results",
      "description": "Output directory."
    }
  },
  "required": ["bam_dir"]
}
